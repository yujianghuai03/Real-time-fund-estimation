{
  "name": "yujianghuai-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portal": "npm --workspace @yujianghuai/portal run dev",
    "dev:admin": "npm --workspace @yujianghuai/admin run dev",
    "build": "npm run build:portal && npm run build:admin",
    "build:portal": "npm --workspace @yujianghuai/portal run build",
    "build:admin": "npm --workspace @yujianghuai/admin run build",
    "preview:portal": "npm --workspace @yujianghuai/portal run preview",
    "preview:admin": "npm --workspace @yujianghuai/admin run preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "axios": "^1.13.2",
    "element-plus": "^2.11.8",
    "vite": "^5.4.21",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12"
  }
}
